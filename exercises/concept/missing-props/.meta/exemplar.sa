class MISSING_PROPS is

   count_of(props : FMAP{STR,INT}, prop : STR) : INT is
      if ~props.has_ind(prop) then
         -- Nought would say "we have none", which is a different thing.
         raise "Unknown prop: " + prop;
      end;
      return props.get(prop);
   end;

   take_one(props : FMAP{STR,INT}, prop : STR) : INT is
      -- An unknown prop raises inside count_of and travels straight out
      -- through here. Nothing needs saying about it.
      have ::= count_of(props, prop);
      if have = 0 then
         raise "Out of " + prop;
      end;
      return have - 1;
   end;

   report(props : FMAP{STR,INT}, prop : STR) : STR is
      protect
         left ::= take_one(props, prop);
         return "Took " + prop + ", " + left + " left";
      when $STR then
         -- Whatever was raised is already the right words.
         return exception.str;
      end;
   end;

end; -- class MISSING_PROPS
