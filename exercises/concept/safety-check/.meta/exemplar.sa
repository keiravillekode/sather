class SAFETY_CHECK is

   mat_ready(down, clean : BOOL) : BOOL is
      return down and clean;
   end;

   something_below(mat, net : BOOL) : BOOL is
      return mat or net;
   end;

   needs_briefing(briefed : BOOL) : BOOL is
      return ~briefed;
   end;

   old_enough(age : INT) : BOOL is
      return age >= 13;
   end;

   cleared(age : INT, briefed, down, clean : BOOL) : BOOL is
      return old_enough(age) and briefed and mat_ready(down, clean);
   end;

end; -- class SAFETY_CHECK
