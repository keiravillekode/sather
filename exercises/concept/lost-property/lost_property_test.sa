class LOST_PROPERTY_TEST is
   include EXERCISM_TEST;

   main is
      class_name("LOST_BOX");

      box ::= #LOST_BOX{STR}("blue jumper", "Mia");
      test("what is in the box", box.item, "blue jumper");
      test("who handed it in", box.handed_in_by, "Mia");
      test("nobody has claimed it", box.claimed, false);
      test("so it is still waiting", box.waiting, true);
      test("written up", box.describe, "blue jumper, handed in by Mia");

      box.claim;
      test("now it is claimed", box.claimed, true);
      test("so it is no longer waiting", box.waiting, false);

      was ::= box.replace("red jumper");
      test("replace answers what was there", was, "blue jumper");
      test("and the box holds the new thing", box.item, "red jumper");
      test("and says so when written up",
           box.describe, "red jumper, handed in by Mia");

      -- The same class at a different type.
      count ::= #LOST_BOX{INT}(3, "Ben");
      test("a box of a number", count.item, 3);
      test("who handed the number in", count.handed_in_by, "Ben");
      test("unclaimed like any other", count.waiting, true);
      test("written up the same way",
           count.describe, "3, handed in by Ben");

      old_count ::= count.replace(7);
      test("replacing a number answers the old one", old_count, 3);
      test("and the box holds the new number", count.item, 7);

      -- Two boxes of the same type keep their own contents.
      other ::= #LOST_BOX{STR}("water bottle", "Lee");
      test("a second box has its own thing", other.item, "water bottle");
      test("and its own owner", other.handed_in_by, "Lee");
      test("and its own claimed state", other.waiting, true);
      test("the first box is untouched", box.item, "red jumper");
      test("and stays claimed", box.claimed, true);

      finish;
   end;
end; -- class LOST_PROPERTY_TEST
