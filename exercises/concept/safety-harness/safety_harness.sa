class SAFETY_HARNESS is

   readonly attr limit : INT;

   -- Replace each placeholder body with the real one, and give each
   -- routine its contract; the instructions say which.

   create(kg : INT) : SAME is
      -- Make a harness rated for `kg' kilograms.
      return new;
   end;

