class BIRD_SURVEY is

   total_seen(counts : ARRAY{INT}) : INT is
      total ::= 0;
      i ::= 0;
      loop
         until!(i >= counts.size);
         total := total + counts[i];
         i := i + 1;
      end;
      return total;
   end;

   busiest_day(counts : ARRAY{INT}) : INT is
      busiest ::= 0;
      i ::= 0;
      current ::= 0;
      loop
         until!(i >= counts.size);

         current := counts.elt!;
         if busiest < current then
            busiest := current;
         end;

         i := i + 1;
      end;
      return busiest;
   end;


   days_over(counts : ARRAY{INT}, n : INT) : INT is
      result ::= 0;
      loop
         if n < counts.elt! then
            result := result + 1;
         end;
      end;
      return result;
   end;

   hides_to_check(days : INT) : INT is
      return days * (days + 1) / 2;
   end;

   first_busy_day(counts : ARRAY{INT}, n : INT) : INT is
      result ::= 0;
      loop
         if n < counts.elt! then
            return result;
         end;
         result := result + 1;
      end;
      return -1;
   end;

end; -- class BIRD_SURVEY
