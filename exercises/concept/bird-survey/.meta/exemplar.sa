class BIRD_SURVEY is

   -- Replace each placeholder body with the real one.

   total_seen(counts : ARRAY{INT}) : INT is
      total ::= 0;
      i ::= 0;
      loop
         until!(i >= counts.size);
         total := total + counts[i];
         i := i + 1;
      end;
      return total;
   end;

   busiest_day(counts : ARRAY{INT}) : INT is
      largest ::= 0;
      i ::= 0;
      loop
         until!(i >= counts.size);
         if largest < counts[i] then
            largest := counts[i];
         end;
         i := i + 1;
      end;
      return largest;
   end;

   days_over(counts : ARRAY{INT}, than : INT) : INT is
      days ::= 0;
      i ::= 0;
      loop
         until!(i >= counts.size);
         if than < counts[i] then
            days := days + 1;
         end;
         i := i + 1;
      end;
      return days;
   end;

   hides_to_check(days : INT) : INT is
      -- Return 1 + 2 + ... + `days', the number of hide checks.
      return 0;
   end;

   first_busy_day(counts : ARRAY{INT}, than : INT) : INT is
      -- Return the first day with a count above `than', or -1.
      return 0;
   end;

end; -- class BIRD_SURVEY
