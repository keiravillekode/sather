class WARM_UP_LAPS is

   distance_run(laps : INT) : INT is
      distance ::= 0;
      lap ::= 0;
      length ::= 100;
      loop
         if lap = laps then
            return distance;
         end;

         lap := lap + 1;
         distance := distance + length;
         length := length + 10;
      end;
   end;

   laps_to_reach(distance : INT) : INT is
      lap ::= 0;
      length ::= 100;
      loop
         if distance <= 0 then
            return lap;
         end;

         lap := lap + 1;
         distance := distance - length;
         length := length + 10;
      end;
   end;

   first_long_lap(distance : INT) : INT is
      lap ::= 0;
      length ::= 100;
      loop
         lap := lap + 1;
         if length > distance then
            return lap;
         end;

         length := length + 10;
      end;
   end;

end; -- class WARM_UP_LAPS
