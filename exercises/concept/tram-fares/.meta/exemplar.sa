class TRAM_FARES is

   zone_fare(zone : INT) : INT is
      case zone
      when 0 then return 0;          -- the Free Tram Zone
      when 1 then return 550;
      when 2 then return 370;
      else return 0;                 -- not a tram zone at all
      end;
   end;

   ticket_kind(code : CHAR) : STR is
      case code
      when 'f' then return "Full fare";
      when 'c', 's' then return "Concession";
      when 'x' then return "Free pass";
      else return "Unknown";
      end;
   end;

   day_type(day : STR) : STR is
      case day
      when "Sat", "Sun" then return "Weekend";
      when "Mon", "Tue", "Wed", "Thu", "Fri" then return "Weekday";
      else return "Unknown";
      end;
   end;

   daily_cap(day : STR) : INT is
      -- Ask the routine that already knows the days, so the list of them
      -- is written once.
      case day_type(day)
      when "Weekday" then return 1100;
      when "Weekend" then return 700;
      else return 0;
      end;
   end;

end; -- class TRAM_FARES
