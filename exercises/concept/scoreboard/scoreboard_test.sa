class SCOREBOARD_TEST is
   include EXERCISM_TEST;

   main is
      class_name("SCOREBOARD");

      board ::= #SCOREBOARD("Vixens", "Magpies");
      test("home starts at nothing", board.home_score, 0);
      test("away starts at nothing", board.away_score, 0);
      test("the teams are remembered", board.home_team, "Vixens");
      test("both teams are remembered", board.away_team, "Magpies");
      test("nothing has happened yet",
           board.summary, "Vixens 0 - 0 Magpies");
      test("level at the start", board.leader, "Draw");
      test("no margin at the start", board.margin, 0);

      board.home_goal;
      test("one goal to the home team", board.home_score, 1);
      test("the away team is untouched", board.away_score, 0);
      test("the board reads one nil",
           board.summary, "Vixens 1 - 0 Magpies");
      test("the home team leads", board.leader, "Vixens");
      test("one goal in it", board.margin, 1);

      board.away_goal;
      board.away_goal;
      test("two goals to the away team", board.away_score, 2);
      test("the board reads one two",
           board.summary, "Vixens 1 - 2 Magpies");
      test("the away team leads", board.leader, "Magpies");
      test("one goal in it the other way", board.margin, 1);

      board.home_goal;
      test("level again", board.leader, "Draw");
      test("no margin again", board.margin, 0);

      -- A second board keeps its own score.
      other ::= #SCOREBOARD("Swifts", "Firebirds");
      test("a new board starts fresh", other.home_score, 0);
      test("the first board is untouched", board.home_score, 2);
      other.home_goal;
      test("the new board scores", other.home_score, 1);
      test("the first board still has its own",
           board.home_score, 2);
      test("and its own teams",
           other.summary, "Swifts 1 - 0 Firebirds");

      finish;
   end;
end; -- class SCOREBOARD_TEST
